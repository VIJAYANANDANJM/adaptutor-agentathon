# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only OPENROUTER_API_KEY is needed for real mode.
# For mock mode (default), no .env is needed at all.
# ---------------------------------------------------------------------------

# LLM mode: "mock" (default, no API key needed) or "real" (requires key below)
LLM_MODE=mock

# Required only for LLM_MODE=real
OPENROUTER_API_KEY=

# Model selection (only used in real mode)
SLICE_MODEL=inclusionai/ling-3.0-flash
SLICE_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct
SLICE_ESCALATION_MODEL=anthropic/claude-haiku-4.5

# Budgets
SLICE_MAX_TOKENS_PER_RUN=250000
SLICE_MAX_TOKENS=1200
SLICE_MAX_ATTEMPTS_PER_STEP=3
SLICE_EXPERT_TIMEOUT_MINUTES=45

# Optional tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
